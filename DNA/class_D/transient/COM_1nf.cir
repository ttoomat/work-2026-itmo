* AC coupled clock rejects clock DC level/duty imbalance.
* DC=2.5 models an already charged coupling capacitor, NOT cold startup.
Cclock clock clockac 100n
RclockA clockac clockr 14.3k
RclockB clockr tsum 169
Ctriangle tsum triangle 54p
Rtriangle tsum triangle 49.9k
Xtriangle mid tsum triangle logic 0 OPA810
.include "../models/compatible/TLV3603.lib"
Xcmp mix triangle logic 0 rawcmp logic CMP3603_TLV3603
Rcmp rawcmp 0 10k
Rhys rawcmp mix 100Meg
Rmixlead lead mix 13.3k
Rmixref rnorm mix 100k
Rmixhi logic mix 158k
Rmixlo mix 0 113k
Bcommand command 0 V=780*V(lead,mid)
.model SWMOD SW(Ron=.0135 Roff=1e9 Vt=.5 Vh=0)
.model REV D(Is=1e-13 N=2 Rs=.006 Cjo=0 Tt=0)
.include "../models/compatible/EPC2214.lib"
.include "../models/compatible/LMG1210.lib"
.include "../models/vendor/bat46wj/BAT46WJ.lib"
Venable en 0 5
Vrun run 0 PWL(0 0 1u 0 1.001u 5)
Bdrive gate_src 0 V=V(rawcmp)*(V(run)>2.5)
Tgate gate_src 0 pwmsrc 0 Z0=1k TD=3n
Rgate_term pwmsrc 0 1k
Rpwm pwmsrc pwm1 33
Cpwm pwm1 0 3p
* TI macro exposes thermal-pad placeholders which are grounded internally.
* Bind them to model ground here; physical HS thermal pad follows datasheet HS.
Xdriver hb ho pwm1 sw1 sw1 sw1 sw1 0 0 logic lo dhl dlh logic 0 0 en 0 0 0 bst DRV1210_LMG1210
Rdhl dhl 0 100k
Rdlh dlh 0 100k
Cdriver logic 0 9.4u
Edrv_monitor vdrv 0 logic 0 1
Cboot hb sw1 1u
Dboot bst hb BAT46WJ
Rgh ho gh .51
Rgl lo gl .51
Rghoff gh sw1 10k
Rgloff gl 0 10k
Lbusfeed bus busfeed 2n
Rbusfeed busfeed buslocal .01
Llocalcap buslocal clocalx .5n
Rlocalcap clocalx clocaly .05
Clocalcap clocaly 0 20n
Vqh buslocal hd 0
Xhigh gh hd sw1 FET2214_EPC2214
Vql sw1 ld 0
Xlow gl ld 0 FET2214_EPC2214
L1 sw1 coilend {LPH}
Rcoil coilend shunt .0165
Rshunt shunt lx1 .001
RdampA lx1 out .22
RdampB lx1 out .22

Cfixed out sysgnd {CFIX} 
Rcable out cable 0.22
Lcable cable head 10n
Cload head sysgnd 1n
Rleak head sysgnd 10Meg
.options reltol=1e-3 abstol=1e-8 vntol=1e-6 method=trap
.options solver=alt
.options threads=1 numdgt=7 plotwinsize=0
.tran 0 49.1u 0 1n 
.save V(triangle) V(mix) V(rnorm) V(buslocal) I(Lcable) V(ref) V(head) V(out) I(L1) V(pwm1) V(error) V(servo) V(lead) V(sw1) V(vdrv) V(hb) V(gh) V(gl) I(Vbus) I(Vground) I(Vlogic) I(Vqh) I(Vql)
.end
