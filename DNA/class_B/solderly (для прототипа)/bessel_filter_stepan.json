0-c48d-4f8b-b04e-139708499b74","soldered":true,"definitionId":"female-header","at":[10,11],"rotation":0,"rows":1,"cols":2},{"ref":"PS1","instanceId":"cd994a55-8ffb-4fb3-8f61-d19ce431c7b9","soldered":true,"definitionId":"custom","at":[9,4],"rotation":0,"rows":1,"cols":1,"custom":{"id":"mwf8eexzabsruo","name":"Hi-Link E0512S-1WR3","refPrefix":"PS","cols":9,"rows":3,"pins":[{"at":[1,2],"label":"VIN +5V (1)"},{"at":[2,2],"label":"GND_IN (2)"},{"at":[5,2],"label":"-12V (5)"},{"at":[6,2],"label":"COM_OUT (6)"},{"at":[7,2],"label":"+12V (7)"}],"color":"#171c24","footprintNote":"Hi-Link HLK-E_S-1WR3(H), даташит 2021-4 A/0, стр. 1 и 5. E0512S-1WR3: вход 5 В, изолированные выходы +12 В / COM / -12 В, 1 Вт. Корпус 19,60 × 6,00 × 9,60 мм. Физические выводы: 1 VIN, 2 GND_IN, 5 -Vo, 6 COM_OUT, 7 +Vo; позиции на сетке 2,54 мм: 0, 1, 4, 5, 6. Контакты 1–5 в редакторе соответствуют физическим 1, 2, 5, 6, 7; номера указаны и в подписях. GND_IN и COM_OUT изолированы, внутреннее соединение между ними не задано. Контур 9 × 3 на сетке оставляет запас места вокруг корпуса; точные габариты приведены выше. В 3D используется условная плата модуля, без воспроизведения закрытого корпуса высотой 9,60 мм. Монтажных отверстий нет. Ориентацию определяют по выводу 1; маркировка физического модуля имеет приоритет, как указано производителем.","datasheetUrl":"https://5.imimg.com/data5/SELLER/Doc/2025/10/549732035/WQ/QA/TB/1833510/hi-link-e2412s-1wr3-dc-to-dc-module.pdf"}}],"customIcs":[{"id":136968155,"name":"LM6172IN","widthPin":4,"heightPin":4,"pinDescription":{"1":"OUT1","2":"IN1-","3":"IN1+","4":"V-","5":"IN2+","6":"IN2-","7":"OUT2","8":"V+"},"category":"ics.custom"}]}